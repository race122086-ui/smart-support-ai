# En Railway, DATABASE_URL mantiene PostgreSQL y Prisma como almacenamiento principal.
# Si no se define, el desarrollo local usa .smartsupport/data.json.
DATABASE_URL="postgresql://USUARIO:CONTRASENA@HOST:5432/NOMBRE_DB?schema=public"

# PORT suele ser inyectado por la plataforma. Si no existe, se usa API_PORT.
# PORT="8080"
# API_HOST="127.0.0.1"
API_PORT="3000"
API_CORS_ORIGIN="http://localhost:5173"
API_LOG_LEVEL="info"
# API_DATA_FILE=".smartsupport/data.json"
VITE_API_URL="http://localhost:3000"
