# Sustituye estos marcadores por los valores de tu instancia PostgreSQL.
DATABASE_URL="postgresql://USUARIO:CONTRASENA@HOST:5432/NOMBRE_DB?schema=public"

# PORT suele ser inyectado por la plataforma. Si no existe, se usa API_PORT.
# PORT="8080"
# API_HOST="127.0.0.1"
API_PORT="3000"
API_CORS_ORIGIN="http://localhost:5173"
API_LOG_LEVEL="info"
VITE_API_URL="http://localhost:3000"
