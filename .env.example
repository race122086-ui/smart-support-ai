# En Railway, DATABASE_URL mantiene PostgreSQL y Prisma como almacenamiento principal.
# Si no se define, el desarrollo local usa .smartsupport/data.json.
DATABASE_URL="postgresql://USUARIO:CONTRASENA@HOST:5432/NOMBRE_DB?schema=public"

# PORT suele ser inyectado por la plataforma. Si no existe, se usa API_PORT.
# PORT="8080"
# API_HOST="127.0.0.1"
API_PORT="3000"
API_CORS_ORIGIN="http://localhost:5173"
API_LOG_LEVEL="info"
# API_DATA_FILE=".smartsupport/data.json"
VITE_API_URL="http://localhost:3000"

# Correo saliente. Si la configuración queda incompleta, la API usa modo de registro seguro.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""
SMTP_SECURE="false"
# Origen opcional para enlaces incluidos en correos (FRONTEND_URL tiene precedencia).
FRONTEND_URL="http://localhost:5173"
# WEB_APP_URL="http://localhost:5173"

# Adjuntos de tickets. local guarda binarios en ATTACHMENT_LOCAL_DIR (solo desarrollo).
# s3 requiere S3_BUCKET, S3_REGION, S3_ACCESS_KEY_ID y S3_SECRET_ACCESS_KEY.
# En producción STORAGE_DRIVER debe ser s3 (el disco efímero de Railway no es confiable).
STORAGE_DRIVER="local"
ATTACHMENT_MAX_BYTES="10485760"
ATTACHMENT_MAX_COUNT="5"
# ATTACHMENT_LOCAL_DIR=".smartsupport/uploads"
# S3_BUCKET=""
# S3_REGION=""
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_ENDPOINT=""
# S3_FORCE_PATH_STYLE="false"
# S3_PREFIX=""
