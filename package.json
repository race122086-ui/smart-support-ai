{
  "name": "smart-support-ai",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @smartsupport/web",
    "dev:api": "npm run dev --workspace @smartsupport/api",
    "build": "npm run build --workspaces --if-present",
    "build:web": "npm run build --workspace @smartsupport/web",
    "build:api": "npm run build --workspace @smartsupport/api",
    "test": "npm run test --workspaces --if-present",
    "test:web": "npm run test --workspace @smartsupport/web",
    "test:api": "npm run test --workspace @smartsupport/api",
    "preview": "npm run preview --workspace @smartsupport/web"
  }
}
